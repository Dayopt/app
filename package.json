{
  "name": "boxlog-app",
  "version": "0.19.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "src/styles/globals.css"
  ],
  "scripts": {
    "dev": "vercel env pull .env.local --yes || echo '⚠️ env pull failed, using existing .env.local'; NODE_OPTIONS='--max-old-space-size=12288' next dev",
    "dev:safe": "./scripts/dev-server-guard.sh",
    "dev:kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo 'No server running'",
    "prebuild": "echo 'prebuild: no-op'",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "build:fallback": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "lint": "eslint . --max-warnings 0",
    "lint:boundaries": "node scripts/check-feature-boundaries.mjs",
    "lint:boundaries:update": "node scripts/check-feature-boundaries.mjs --update",
    "lint:tokens": "node scripts/check-tailwind-tokens.js",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "bundle:analyze": "ANALYZE=true npm run build",
    "postinstall": "echo 'postinstall: no-op'",
    "prepare": "husky",
    "log:feat": "git log --grep=\"^feat:\" --pretty=\"%s\"",
    "log:fix": "git log --grep=\"^fix:\" --pretty=\"%s\"",
    "log:type": "git log --pretty=\"%s\" | grep -E '^(feat|fix|docs|style|refactor|perf|test|chore):' | head -20",
    "env:check": "tsc --noEmit src/env.ts",
    "migration:create": "supabase migration new",
    "migration:list": "supabase migration list",
    "migration:status": "supabase db diff",
    "types:generate": "supabase gen types typescript --project-id qloztwfbrbqtjijxicnd > src/lib/database.types.ts",
    "types:generate:staging": "supabase gen types typescript --project-id yvglwblxrnrenfifsnje > src/lib/database.types.ts",
    "types:generate:local": "supabase gen types typescript --local > src/lib/database.types.ts",
    "docs:check": "node scripts/docs-code-consistency.cjs",
    "docs:validate:links": "node scripts/validate-doc-references.js",
    "docs:validate:rules": "node scripts/validate-claude-rules.js",
    "docs:validate": "npm run docs:validate:links && npm run docs:validate:rules",
    "license:check": "npx license-checker --production --excludePackages \"boxlog-app@$(node -p 'require(\"./package.json\").version')\" --onlyAllow \"$(cat .licensrc.json | jq -r .onlyAllow)\"",
    "license:check:force": "npx license-checker --production --excludePackages \"boxlog-app@$(node -p 'require(\"./package.json\").version')\" --onlyAllow \"$(cat .licensrc.json | jq -r .onlyAllow)\" --failOn \"$(cat .licensrc.json | jq -r .onlyAllow)\"",
    "license:check-risks": "tsx scripts/check-license-risks.ts",
    "license:audit": "npx license-checker --production --summary",
    "license:report": "npx license-checker --production --csv > license-report.csv",
    "license:info": "npx license-checker --production --json | jq",
    "generate-licenses": "tsx scripts/generate-licenses.ts",
    "perf:check": "npm run lighthouse:check",
    "perf:lighthouse": "lhci autorun",
    "quality:check": "npm run license:check && npm run perf:check",
    "quality:full": "npm run lint && npm run quality:check && npm run typecheck",
    "test": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:run": "vitest --project unit run",
    "test-storybook": "vitest --project storybook",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --project unit run --coverage",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:integration": "tsc --noEmit --project tsconfig.integration.json 2>&1 | grep -v TS2349 | grep -v TS2578 | grep -v 'src/features/.*error TS2322' | grep -v 'src/features/.*error TS2352' | grep 'error TS' && exit 1 || exit 0",
    "test:coverage:summary": "vitest run --coverage && node -e \"const fs = require('fs'); const c = JSON.parse(fs.readFileSync('./coverage/coverage-summary.json', 'utf8')).total; console.log('📊 Coverage Summary'); console.log('Lines:', c.lines.pct + '%', '| Functions:', c.functions.pct + '%', '| Branches:', c.branches.pct + '%', '| Statements:', c.statements.pct + '%');\"",
    "test:diff-coverage": "npm run test:coverage && node scripts/diff-coverage.mjs",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "db:reset": "supabase db reset --local",
    "db:reset-preview": "supabase db reset --linked",
    "db:seed": "./scripts/seed-dev-data.sh",
    "db:fresh": "npm run db:reset && npm run db:seed",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/test/e2e/smoke.spec.ts",
    "test:e2e:critical": "playwright test src/test/e2e/critical-path.spec.ts src/test/e2e/auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:quality": "npm run test:coverage && npm run test:e2e",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:unused": "node scripts/i18n-unused.js",
    "sentry:test": "node scripts/sentry/connection-test.cjs",
    "sentry:verify": "node scripts/verify-sentry.mjs",
    "vercel:env": "vercel env ls",
    "vercel:env:pull": "vercel env pull .env.local",
    "deps:check": "npm audit --production && ncu --errorLevel 2",
    "deps:outdated": "ncu",
    "deps:circular": "madge --circular --ts-config ./tsconfig.json --extensions ts,tsx src/",
    "lighthouse:check": "lhci autorun",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "security:audit": "npm audit --production",
    "security:fix": "npm audit fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:check": "npm audit --audit-level=moderate",
    "security:check:production": "npm audit --production --audit-level=high",
    "security:full": "npm run security:check && npm run typecheck && npm run lint",
    "security:audit:actions": "node scripts/audit-github-actions.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/openai": "^3.0.29",
    "@ai-sdk/react": "^3.0.88",
