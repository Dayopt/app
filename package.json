    "@vitest/ui": "^4.0.14",
    "@vueless/storybook-dark-mode": "^10.0.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-storybook": "^10.2.17",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "knip": "^5.88.0",
    "license-checker": "^25.0.1",
    "lightningcss": "^1.30.1",
    "lint-staged": "^16.1.6",
    "madge": "^8.0.0",
    "npm-check-updates": "^19.0.0",
    "playwright": "^1.56.0",
    "postcss": "^8",
    "prettier": "^3.3.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "remark-gfm": "^4.0.1",
    "size-limit": "^11.2.0",
    "storybook": "^10.2.17",
    "supabase": "^2.30.4",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "zod-to-json-schema": "^3.25.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
