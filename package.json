{
  "name": "dayopt",
  "version": "0.30.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "bash scripts/dev-with-op.sh",
    "dev:raw": "pnpm --filter @dayopt/product dev:raw",
    "dev:product": "pnpm --filter @dayopt/product dev",
    "dev:op": "pnpm dev",
    "typecheck:op": "op run --env-file=.op-env.local -- pnpm typecheck",
    "env:check": "op run --env-file=.op-env.local -- pnpm exec tsx scripts/env/check-env.ts",
    "secrets:check": "pnpm exec tsx scripts/env/check-secrets.ts",
    "1password:check": "pnpm exec tsx scripts/env/check-1password.ts",
    "build": "pnpm --filter @dayopt/product build",
    "build:product": "pnpm --filter @dayopt/product build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "start": "pnpm --filter @dayopt/product start",
    "start:product": "pnpm --filter @dayopt/product start",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run",
    "check:workspace": "pnpm typecheck && pnpm lint && pnpm build:packages && pnpm build-storybook",
    "lint": "turbo run lint",
    "lint:product": "pnpm --filter @dayopt/product lint",
    "lint:boundaries": "pnpm --filter @dayopt/product lint:boundaries",
    "lint:boundaries:update": "pnpm --filter @dayopt/product lint:boundaries:update",
    "lint:tokens": "pnpm --filter @dayopt/product lint:tokens",
    "lint:fix": "pnpm --filter @dayopt/product lint:fix",
    "typecheck": "turbo run typecheck",
    "typecheck:product": "pnpm --filter @dayopt/product typecheck",
    "typecheck:packages": "turbo run typecheck --filter='./packages/*'",
    "prepare": "husky",
    "migration:create": "supabase migration new",
    "migration:list": "supabase migration list",
    "migration:status": "supabase db diff",
    "types:generate": "pnpm types:generate:production",
    "types:generate:production": "supabase gen types typescript --project-id yvglwblxrnrenfifsnje > packages/database/src/generated/database.types.ts",
    "types:generate:local": "supabase gen types typescript --local > packages/database/src/generated/database.types.ts",
    "lint:i18n": "pnpm --filter @dayopt/product lint:i18n",
    "i18n:add-locale": "pnpm --filter @dayopt/product i18n:add-locale",
    "docs:check": "pnpm --filter @dayopt/product docs:check",
    "api:spec": "pnpm --filter @dayopt/product api:spec",
    "api:spec:check": "pnpm --filter @dayopt/product api:spec:check",
    "rls:snapshot": "tsx scripts/generate-rls-snapshot.ts",
    "rls:snapshot:check": "tsx scripts/generate-rls-snapshot.ts --check",
    "license:check": "pnpm --filter @dayopt/product license:check",
    "license:check-risks": "pnpm --filter @dayopt/product license:check-risks",
    "license:audit": "pnpm --filter @dayopt/product license:audit",
    "generate-licenses": "pnpm --filter @dayopt/product generate-licenses",
    "perf:lighthouse": "pnpm --filter @dayopt/product perf:lighthouse",
    "quality:full": "pnpm --filter @dayopt/product quality:full",
    "quality:deadcode": "pnpm --filter @dayopt/product quality:deadcode",
    "quality:deadcode:ci": "pnpm --filter @dayopt/product quality:deadcode:ci",
    "test": "pnpm --filter @dayopt/product test",
    "test:product": "pnpm --filter @dayopt/product test",
    "test:run": "pnpm --filter @dayopt/product test:run",
    "test-storybook": "pnpm --filter @dayopt/storybook test-storybook",
    "test-storybook:dark": "pnpm --filter @dayopt/storybook test-storybook:dark",
    "test:ui": "pnpm --filter @dayopt/product test:ui",
    "test:coverage": "pnpm --filter @dayopt/product test:coverage",
    "test:diff-coverage": "pnpm --filter @dayopt/product test:diff-coverage",
    "test:watch": "pnpm --filter @dayopt/product test:watch",
    "test:integration": "pnpm --filter @dayopt/product test:integration",
    "db:reset": "pnpm --filter @dayopt/product db:reset",
    "db:reset-linked:unsafe": "pnpm --filter @dayopt/product db:reset-linked:unsafe",
    "db:seed": "pnpm --filter @dayopt/product db:seed",
    "db:fresh": "pnpm --filter @dayopt/product db:fresh",
    "test:e2e": "pnpm --filter @dayopt/product test:e2e",
    "test:e2e:smoke": "pnpm --filter @dayopt/product test:e2e:smoke",
    "test:e2e:critical": "pnpm --filter @dayopt/product test:e2e:critical",
    "test:e2e:ui": "pnpm --filter @dayopt/product test:e2e:ui",
    "test:e2e:headed": "pnpm --filter @dayopt/product test:e2e:headed",
    "i18n:check": "pnpm --filter @dayopt/product i18n:check",
    "i18n:unused": "pnpm --filter @dayopt/product i18n:unused",
    "vercel:env": "vercel env ls",
    "vercel:env:pull:unsafe": "vercel env pull apps/product/.env.local --environment preview",
    "deps:check": "pnpm --filter @dayopt/product deps:check",
    "deps:circular": "pnpm --filter @dayopt/product deps:circular",
    "size": "pnpm --filter @dayopt/product size",
    "size:why": "pnpm --filter @dayopt/product size:why",
    "size:budget": "pnpm --filter @dayopt/product size:budget",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:check": "pnpm --filter @dayopt/product security:check",
    "security:check:production": "pnpm --filter @dayopt/product security:check:production",
    "storybook:coverage": "pnpm --filter @dayopt/product storybook:coverage",
    "storybook": "pnpm --filter @dayopt/storybook storybook",
    "build-storybook": "pnpm --filter @dayopt/storybook build",
    "dev:web": "pnpm --filter @dayopt/web dev",
    "build:web": "pnpm --filter @dayopt/web build",
    "start:web": "pnpm --filter @dayopt/web start",
    "lint:web": "pnpm --filter @dayopt/web lint",
    "typecheck:web": "pnpm --filter @dayopt/web typecheck",
    "test:web": "pnpm --filter @dayopt/web test",
    "eagle:capture": "pnpm --filter @dayopt/product eagle:capture",
    "eagle:sync": "pnpm --filter @dayopt/product eagle:sync",
    "eagle:sync:dry": "pnpm --filter @dayopt/product eagle:sync:dry",
    "eagle:sync:capture": "pnpm --filter @dayopt/product eagle:sync:capture",
    "eagle:setup": "pnpm --filter @dayopt/product eagle:setup",
    "eagle:cleanup": "pnpm --filter @dayopt/product eagle:cleanup",
    "eagle:lookup": "pnpm --filter @dayopt/product eagle:lookup",
    "eagle:test": "pnpm --filter @dayopt/product eagle:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@axe-core/react": "^4.11.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^11.2.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "happy-dom": "^20.10.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "next": "^16.2.9",
    "npm-check-updates": "^19.6.6",
    "playwright": "^1.56.0",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.1",
    "size-limit": "^11.2.0",
    "storybook": "^10.4.6",
    "supabase": "^2.106.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.4",
      "tmp": "^0.2.4",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
