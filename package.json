{
  "name": "dayopt-app",
  "version": "0.23.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "src/styles/globals.css"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=12288' next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "lint": "eslint . --max-warnings 0",
    "lint:boundaries": "tsx scripts/check-feature-boundaries.ts",
    "lint:boundaries:update": "tsx scripts/check-feature-boundaries.ts --update",
    "lint:tokens": "tsx src/styles/scripts/check-tokens.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "migration:create": "supabase migration new",
    "migration:list": "supabase migration list",
    "migration:status": "supabase db diff",
    "types:generate": "supabase gen types typescript --project-id qloztwfbrbqtjijxicnd > src/lib/database.types.ts",
    "types:generate:staging": "supabase gen types typescript --project-id yvglwblxrnrenfifsnje > src/lib/database.types.ts",
    "types:generate:local": "supabase gen types typescript --local > src/lib/database.types.ts",
    "lint:i18n": "tsx scripts/check-i18n-integrity.ts",
    "i18n:add-locale": "tsx scripts/add-locale.ts",
    "docs:check": "tsx scripts/validate-doc-references.ts",
    "api:spec": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy SUPABASE_SERVICE_ROLE_KEY=dummy tsx scripts/generate-api-spec.ts",
    "api:spec:check": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy SUPABASE_SERVICE_ROLE_KEY=dummy tsx scripts/generate-api-spec.ts --check",
    "license:check": "npx license-checker --production --excludePackages \"dayopt-app@$(node -p 'require(\"./package.json\").version')\" --onlyAllow \"$(cat .licensrc.json | jq -r .onlyAllow)\"",
    "license:check-risks": "tsx scripts/check-license-risks.ts",
    "license:audit": "npx license-checker --production --summary",
    "generate-licenses": "tsx scripts/generate-licenses.ts",
    "perf:lighthouse": "lhci autorun",
    "quality:full": "npm run lint && npm run license:check && npm run perf:lighthouse && npm run typecheck",
    "quality:collect": "tsx scripts/collect-quality-metrics.ts",
    "quality:collect:fast": "tsx scripts/collect-quality-metrics.ts --skip=a11y,testCoverage",
    "quality:deadcode": "knip --reporter json",
    "quality:deadcode:ci": "knip --no-exit-code",
    "test": "vitest --project unit",
    "test:run": "vitest --project unit run",
    "test-storybook": "vitest --project storybook",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --project unit run --coverage",
    "test:diff-coverage": "npm run test:coverage && tsx scripts/diff-coverage.ts",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "db:reset": "supabase db reset --local",
    "db:reset-preview": "supabase db reset --linked",
    "db:seed": "./scripts/seed-dev-data.sh",
    "db:fresh": "npm run db:reset && npm run db:seed",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/test/e2e/smoke.spec.ts",
    "test:e2e:critical": "playwright test src/test/e2e/critical-path.spec.ts src/test/e2e/auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "i18n:check": "tsx src/platform/i18n/scripts/check-keys.ts",
    "i18n:unused": "tsx src/platform/i18n/scripts/find-unused.ts",
    "vercel:env": "vercel env ls",
    "vercel:env:pull": "vercel env pull .env.local --environment preview",
    "deps:check": "npm audit --production && ncu --errorLevel 2",
    "deps:circular": "madge --circular --ts-config ./tsconfig.json --extensions ts,tsx src/",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:check": "npm audit --audit-level=moderate",
    "security:check:production": "npm audit --production --audit-level=high",
    "storybook:coverage": "tsx scripts/check-story-coverage.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.49",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.10",
    "@sentry/nextjs": "^10.46.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-persist-client": "^5.95.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@tiptap/extension-link": "^3.21.0",
    "@tiptap/extension-task-item": "^3.21.0",
    "@tiptap/extension-task-list": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@trpc/client": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.141",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.1",
    "react-email": "^5.2.10",
    "react-hook-form": "^7.72.0",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "web-vitals": "^5.2.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "sharp": false,
    "tar": "^7.5.4",
    "tmp": "^0.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@axe-core/react": "^4.11.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.0.5",
    "@playwright/test": "^1.56.0",
    "@prisma/instrumentation": "^6.17.1",
    "@size-limit/preset-app": "^11.2.0",
    "@storybook/addon-a11y": "^10.2.17",
    "@storybook/addon-docs": "^10.2.17",
    "@storybook/addon-mcp": "^0.3.2",
    "@storybook/addon-vitest": "^10.2.17",
    "@storybook/nextjs-vite": "^10.2.17",
    "@tailwindcss/postcss": "^4.1.7",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.0.14",
