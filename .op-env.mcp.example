# Claude Code の MCP 用トークン注入テンプレート（#1142 / mcp-integration-setup）
#
# これは「Claude 起動時に MCP サーバーへトークンを渡す」ための op:// 参照ファイル。
# 値は書かない（op run が 1Password から解決する）。dev 用の .op-env.local とは別物。
#
# セットアップ:
#   1. このファイルを ~/.config/claude/op-env.mcp にコピー
#   2. ~/.zshrc に op run ラッパーを追加（mcp-usage.md 参照）:
#        claude() { op run --env-file="$HOME/.config/claude/op-env.mcp" -- command claude "$@"; }
#   3. zsh から `claude` を起動 → MCP にトークンが注入される
#
# GitHub / Vercel の MCP は OAuth 承認方式（/mcp で承認）のためトークン不要。ここには書かない。

SENTRY_ACCESS_TOKEN=op://Dayopt-Shared/sentry/SENTRY_AUTH_TOKEN
SUPABASE_ACCESS_TOKEN=op://Dayopt-Staging/supabase/SUPABASE_ACCESS_TOKEN
