# 管理者運用スクリプト専用の env 参照。
#
# scripts/admin-*.sh / verify-login.sh / USE_LINKED_DB=true の seed-dev-data.sh は
# production project を対象に実行する。これらは .op-env.local ではなくこのファイルを使う:
#
#   cp .op-env.admin.example .op-env.admin
#   op run --env-file=.op-env.admin -- env USER_EMAIL=foo@example.com bash scripts/admin-show-user.sh
#
# 参照先が Dayopt-Production である以上、実行は production への操作になる。
# 手順と作業ログの規約は docs/operations/tooling.md 第4部 を正本とする。
# 通常の local dev では使わない（pnpm dev は Supabase local を見る）。
NEXT_PUBLIC_SUPABASE_URL=op://Dayopt-Production/supabase/NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=op://Dayopt-Production/supabase/NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=op://Dayopt-Production/supabase/SUPABASE_SERVICE_ROLE_KEY
