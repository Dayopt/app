# Dayopt web env reference
#
# Secrets are managed in 1Password. Do not put real values in this file.
# Local development should use the repository root `.op-env.local` file:
#
#   cp .op-env.local.example .op-env.local
#   op run --env-file=.op-env.local -- pnpm --filter @dayopt/web dev
#
# `.env.local` is unsafe / temporary only. If a tool generates it, delete it
# after the task. The canonical schema lives in:
# docs/operations/secrets.md
#
# Web env names currently consumed by the app:
NODE_ENV=
CI=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
VERCEL_URL=
PRIVACY_PROTECTION_MODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
YAHOO_VERIFICATION=
