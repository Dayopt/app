{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,default,template,route,global-error,opengraph-image,sitemap}.{ts,tsx}",
    "src/lib/i18n/request.ts",
    "src/lib/i18n/scripts/find-unused.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/**/*.stories.tsx",
    "src/**/*.test.{ts,tsx}",
    "src/**/*.spec.{ts,tsx}",
    ".storybook/stories/**",
    "src/test/**",
    "src/emails/**",
    "src/lib/database/**"
  ],
  "ignoreDependencies": [
    "@axe-core/react",
    "@next/bundle-analyzer",
    "@storybook/*",
    "@vueless/storybook-dark-mode",
    "husky",
    "storybook",
    "@dayopt/*",
    "sharp",
    "tw-animate-css",
    "@tailwindcss/typography",
    "postcss-load-config"
  ],
  "ignoreBinaries": ["op", "jq", "psql"]
}
