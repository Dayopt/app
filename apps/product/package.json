{
  "name": "@dayopt/product",
  "version": "0.27.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "src/lib/styles/globals.css"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=12288' next dev",
    "dev:op": "op run --env-file=../../.op-env.local -- pnpm dev",
    "typecheck:op": "op run --env-file=../../.op-env.local -- pnpm typecheck",
    "env:check": "op run --env-file=../../.op-env.local -- node -e \"['NEXT_PUBLIC_SUPABASE_URL','NEXT_PUBLIC_APP_URL','STRIPE_SECRET_KEY','UPSTASH_REDIS_REST_URL'].forEach(k=>console.log(k+'=' + (process.env[k]?.slice(0,40) ?? '(empty)')))\"",
    "build": "NODE_OPTIONS='--max-old-space-size=12288' next build",
    "start": "next start",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run",
    "lint": "eslint . --max-warnings 0",
    "lint:boundaries": "tsx ../../scripts/check-feature-boundaries.ts",
    "lint:boundaries:update": "tsx ../../scripts/check-feature-boundaries.ts --update",
    "lint:tokens": "tsx src/lib/styles/scripts/check-tokens.ts",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "lint:i18n": "tsx ../../scripts/check-i18n-integrity.ts",
    "i18n:add-locale": "tsx ../../scripts/add-locale.ts",
    "docs:check": "tsx ../../scripts/validate-doc-references.ts",
    "api:spec": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy SUPABASE_SERVICE_ROLE_KEY=dummy tsx ../../scripts/generate-api-spec.ts",
    "api:spec:check": "NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy SUPABASE_SERVICE_ROLE_KEY=dummy tsx ../../scripts/generate-api-spec.ts --check",
    "license:check": "license-checker --production --excludePrivatePackages --onlyAllow \"$(cat .licensrc.json | jq -r .onlyAllow)\"",
    "license:check-risks": "tsx ../../scripts/check-license-risks.ts",
    "license:audit": "license-checker --production --summary",
    "generate-licenses": "tsx ../../scripts/generate-licenses.ts",
    "perf:lighthouse": "lhci autorun",
    "quality:full": "pnpm lint && pnpm license:check && pnpm perf:lighthouse && pnpm typecheck",
    "quality:deadcode": "knip --config knip.json --reporter json",
    "quality:deadcode:ci": "knip --config knip.json --no-exit-code",
    "test": "vitest --project unit",
    "test:run": "vitest --project unit run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --project unit run --coverage",
    "test:diff-coverage": "pnpm test:coverage && tsx ../../scripts/diff-coverage.ts",
    "test:watch": "vitest --watch",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "db:reset": "supabase db reset --local",
    "db:reset-preview": "supabase db reset --linked",
    "db:seed": "../../scripts/seed-dev-data.sh",
    "db:fresh": "pnpm db:reset && pnpm db:seed",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test src/lib/test/e2e/smoke.spec.ts",
    "test:e2e:critical": "playwright test src/lib/test/e2e/critical-path.spec.ts src/lib/test/e2e/auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "i18n:check": "tsx src/lib/i18n/scripts/check-keys.ts",
    "i18n:unused": "tsx src/lib/i18n/scripts/find-unused.ts",
    "deps:check": "pnpm audit --prod && ncu --errorLevel 2",
    "deps:circular": "madge --circular --ts-config ./tsconfig.json --extensions ts,tsx src/",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "size:budget": "tsx ../../scripts/check-bundle-budget.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:check": "pnpm audit --audit-level=moderate",
    "security:check:production": "pnpm audit --prod --audit-level=high",
    "storybook:coverage": "tsx ../../scripts/check-story-coverage.ts",
    "eagle:capture": "tsx ../../scripts/eagle-capture.ts",
    "eagle:sync": "tsx ../../scripts/eagle-sync.ts",
    "eagle:sync:dry": "tsx ../../scripts/eagle-sync.ts --dry-run",
    "eagle:sync:capture": "tsx ../../scripts/eagle-capture.ts && tsx ../../scripts/eagle-sync.ts",
    "eagle:setup": "tsx ../../scripts/eagle-sync.ts --setup",
    "eagle:cleanup": "tsx ../../scripts/eagle-cleanup.ts",
    "eagle:lookup": "tsx ../../scripts/eagle-lookup.ts",
    "eagle:test": "tsx ../../scripts/eagle-api.ts"
  },
  "dependencies": {
    "@dayopt/config": "workspace:*",
    "@dayopt/database": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/auth-js": "^2.106.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/query-persist-client-core": "^5.100.14",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.25",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@axe-core/react": "^4.11.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@next/env": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@size-limit/preset-app": "^11.2.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "axe-core": "^4.11.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-storybook": "^10.4.1",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "glob": "^13.0.6",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "license-checker": "^25.0.1",
    "lightningcss": "^1.30.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "mermaid": "^11.15.0",
    "npm-check-updates": "^19.6.6",
    "playwright": "^1.56.0",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "size-limit": "^11.2.0",
    "storybook": "^10.4.1",
    "supabase": "^2.101.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^4.1.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "size-limit": [
    {
      "name": "CSS bundle (gzip)",
      "path": [
        ".next/static/chunks/*.css"
      ],
      "gzip": true,
      "limit": "95 KB"
    }
  ]
}
