# Dayopt product env reference
#
# Secrets are managed in 1Password. Do not put real values in this file.
# Local development should use the repository root `.op-env.local` file:
#
#   cp .op-env.local.example .op-env.local
#   op run --env-file=.op-env.local -- pnpm --filter @dayopt/product dev
#
# `.env.local` is unsafe / temporary only. If a tool generates it, delete it
# after the task. The canonical schema lives in:
# apps/storybook/docs/operations/secrets.mdx
#
# Product env names currently consumed by the app:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RECOVERY_CODE_PEPPER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
SLACK_BILLING_WEBHOOK_URL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GITHUB_CONTACT_REPO=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_MAINTENANCE_MODE=
SKIP_AUTH_IN_DEV=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
