{
  "mcpServers": {
    "eagle": {
      "type": "http",
      "url": "http://127.0.0.1:41596/mcp"
    },
    "supabase-local": {
      "type": "http",
      "url": "http://127.0.0.1:54321/mcp"
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "env": {}
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "supabase": {
      "type": "stdio",
      "command": "op",
      "args": [
        "run",
        "--no-masking",
        "--",
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=yvglwblxrnrenfifsnje"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "op://Dayopt-Staging/supabase/SUPABASE_ACCESS_TOKEN"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "github": {
      "type": "stdio",
      "command": "op",
      "args": ["run", "--no-masking", "--", "github-mcp-server", "stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "op://Dayopt-Shared/github-mcp-pat/credential"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
