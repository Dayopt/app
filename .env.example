# ========================================
# Dayopt - 環境変数テンプレート
# ========================================
# `vercel env pull .env.local` で自動取得されます。
# 手動設定が必要な場合のみこのファイルを参考にしてください。

# ── Supabase ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Authentication ────────────────────
# 本番環境では必須（未設定だと起動時エラー）
RECOVERY_CODE_PEPPER=your-recovery-code-pepper

# ── Upstash Redis（Rate Limiting）─────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── reCAPTCHA ─────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_V3=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY_V2=
RECAPTCHA_SECRET_KEY_V3=
RECAPTCHA_SECRET_KEY_V2=

# ── Stripe（課金）─────────────────────
# STRIPE_SECRET_KEY と STRIPE_WEBHOOK_SECRET はペアで設定
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# ── Slack（通知）─────────────────────
SLACK_BILLING_WEBHOOK_URL=

# ── Sentry（エラー監視）──────────────
# ビルド時: SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN が必要
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_...

# ── Resend（メール送信）──────────────
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Anthropic（AI Chat）──────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub（Contact Issue）───────────
GITHUB_TOKEN=ghp_...
GITHUB_CONTACT_REPO=owner/repo

# ── Google ────────────────────────────
GOOGLE_SITE_VERIFICATION=

# ── App Config ────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.19.0
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ── Development Only ─────────────────
SKIP_AUTH_IN_DEV=false

# ── E2E Test ─────────────────────────
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=

# ── Vercel（自動設定）────────────────
# VERCEL_URL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA は Vercel が自動設定
