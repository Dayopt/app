{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=$(git rev-parse --show-toplevel) || exit 2; exec bash \"$root/scripts/hooks/codex-pre-tool-guard.sh\"'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/tasks/agent-preflight.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
