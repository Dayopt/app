{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @dayopt/product build",
  "devCommand": "pnpm --filter @dayopt/product dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/product/.next",
  "framework": "nextjs",
  "regions": ["hnd1"],
  "git": {
    "deploymentEnabled": true
  },
  "crons": [
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/external-connection-maintenance",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/mcp",
      "has": [{ "type": "host", "value": "mcp.dayopt.app" }]
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp",
      "has": [{ "type": "host", "value": "mcp.dayopt.app" }]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/well-known/oauth-protected-resource",
      "has": [{ "type": "host", "value": "mcp.dayopt.app" }]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/well-known/oauth-authorization-server",
      "has": [{ "type": "host", "value": "app.dayopt.app" }]
    },
    {
      "source": "/oauth/token",
      "destination": "/api/oauth/token",
      "has": [{ "type": "host", "value": "app.dayopt.app" }]
    }
  ]
}
